# O que FICA no Git (não ignorar):
#   android/build.gradle, android/settings.gradle, android/gradle.properties
#   android/app/build.gradle, android/app/src/main/ (manifest, ícones, MainActivity.java)
#   android/gradlew, android/gradlew.bat, android/gradle/wrapper/  (Gradle wrapper)